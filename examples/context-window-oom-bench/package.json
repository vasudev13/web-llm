{
  "name": "context-window-oom-bench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prestart": "node scripts/ensure-vendor-source-stubs.js",
    "prebuild": "node scripts/ensure-vendor-source-stubs.js",
    "start": "rm -rf .parcel-cache && parcel src/context_window_oom_bench.html --port 8888 --no-source-maps",
    "build": "rm -rf .parcel-cache && parcel build src/context_window_oom_bench.html --dist-dir lib --no-source-maps --public-url ./",
