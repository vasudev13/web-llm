    "start:isolated": "npm run build && node scripts/serve-isolated.mjs lib"
  },
  "devDependencies": {
    "buffer": "^5.7.1",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "parcel": "^2.8.3",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "tslib": "^2.3.1",
    "typescript": "^4.9.5",
    "url": "^0.11.3",
    "vm-browserify": "^1.1.2"
  },
  "alias": {
    "@mlc-ai/web-llm": "../../src/index.ts",
    "ws": "./stubs/ws-stub.js"
  }
